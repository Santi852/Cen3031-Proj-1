{
  "name": "backend",
  "version": "1.0.0",
  "description": "StackSprint API server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "db:migrate": "node-pg-migrate up",
    "db:rollback": "node-pg-migrate down",
    "test:db": "vitest run tests",
    "smoke:leetcode": "tsx scripts/leetcode-smoke.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "argon2": "0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.1",
    "jose": "6.2.12",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "private": true
}
