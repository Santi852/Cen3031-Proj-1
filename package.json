{
  "name": "stacksprint",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "setup": "npm ci --prefix backend && npm ci --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "typecheck": "npm run typecheck --prefix backend && npm run typecheck --prefix frontend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --prefix backend",
    "test:e2e": "npm run test:e2e --prefix frontend",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm test",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:rollback": "npm run db:rollback --prefix backend",
    "test:db": "npm run test:db --prefix backend",
    "smoke:leetcode": "npm run smoke:leetcode --prefix backend --"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
